@PACKAGE_INIT@

# The exported target carries the shared library's actual filename, SONAME,
# include directories, C++ standard and link interface from its build target.
# Public headers use MPI and the generated DDLA_HAS_GPU capability; consumers
# do not need private DDLA_USE_* vendor or communication definitions.
include(CMakeFindDependencyMacro)
find_dependency(MPI COMPONENTS CXX)
if(@DDLA_PACKAGE_NEEDS_CUDATOOLKIT@)
    find_dependency(CUDAToolkit)
endif()
if(@DDLA_PACKAGE_NEEDS_NCCL@)
    find_dependency(NCCL)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LibDDLATargets.cmake")
check_required_components(LibDDLA)
