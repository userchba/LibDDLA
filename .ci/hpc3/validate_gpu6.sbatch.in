#!/usr/bin/env bash
# GPU validation (6-rank suite): indexed addition and all GEMM branches
# on six V100s, one rank per GPU. This independent build tree can run in
# parallel with the default four-rank suite.
#SBATCH --job-name=libddla-hpc3-gpu6
#SBATCH --partition=@GPU6_PARTITION@
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=@GPU6_CPUS@
#SBATCH --gres=gpu:@GPU6_GPUS@
#SBATCH --mem=@GPU6_MEM@
#SBATCH --time=@GPU6_TIME@
#SBATCH --output=@RESULTS@/gpu6-slurm-%j.log
#SBATCH --export=NIL

set -euo pipefail
export HOME=@HOME@
export USER=${SLURM_JOB_USER:?}
export LOGNAME=$USER
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# @BUILD_GPU6@ is on the node-local /tmp (see submit.sh); remove it on exit.
trap 'rm -rf "@BUILD_GPU6@"' EXIT
trap 'exit 143' TERM
export TMPDIR=@BUILD_GPU6@/tmp
mkdir -p "$TMPDIR"
source @CONTROL@/setup_gpu.sh

echo "job $SLURM_JOB_ID on $(hostname) gpus=$(nvidia-smi -L | wc -l)"
module -t list 2>&1 | tee @RESULTS@/gpu6-modules.txt
command -v cmake mpicxx mpirun nvcc | tee @RESULTS@/gpu6-tools.txt

MPIWRAP=@CONTROL@/gpurank_wrapper.sh
chmod +x "$MPIWRAP"

stage_gpu_libs @BUILD_GPU6@/gpu-libs &
stage_libs=$!

# Independent build tree (the two GPU jobs run in parallel).
cmake -S @SOURCE@ -B @BUILD_GPU6@ \
    -DDDLA_USE_CUDA=ON \
    -DDDLA_USE_CCL=ON \
    -DBUILD_TESTS=ON \
    -DDDLA_TEST_NP=6 \
    -DCMAKE_CUDA_ARCHITECTURES=70 \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER=g++ \
    -DMPIEXEC_EXECUTABLE="$MPIWRAP" \
    -DMPIEXEC_PREFLAGS=--oversubscribe \
    2>&1 | tee @RESULTS@/gpu6-configure.log
cmake --build @BUILD_GPU6@ --parallel 16 --target test_pgeadd_indexed test_pgemm_branches 2>&1 | tee @RESULTS@/gpu6-build.log
wait "$stage_libs" || true
export LD_LIBRARY_PATH=@BUILD_GPU6@/gpu-libs:$LD_LIBRARY_PATH

export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5
set +e
ctest --test-dir @BUILD_GPU6@ --output-on-failure -j1 \
    -R "^test_(pgeadd_indexed|pgemm_branches)_mpi$" \
    --output-junit @RESULTS@/gpu6-ctest.xml 2>&1 | tee @RESULTS@/gpu6-ctest.log
rc=${PIPESTATUS[0]}
set -e

python3 @CONTROL@/report.py --kind gpu6 --junit @RESULTS@/gpu6-ctest.xml \
    --results @RESULTS@ --job-id "$SLURM_JOB_ID"
exit "$rc"
