#!/usr/bin/env bash
# GPU validation (4-rank suite): configure, build, and run every CTest
# entry that registers at DDLA_TEST_NP=4 ranks (plus the two 1-rank
# potrf_bottom_right cases) on 4 V100s — one rank per GPU. The 6-rank
# test_ptran runs in a separate 6-GPU job (validate_gpu6.sbatch.in).
#SBATCH --job-name=libddla-hpc3-gpu4
#SBATCH --partition=@GPU4_PARTITION@
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=@GPU4_CPUS@
#SBATCH --gres=gpu:@GPU4_GPUS@
#SBATCH --mem=@GPU4_MEM@
#SBATCH --time=@GPU4_TIME@
#SBATCH --output=@RESULTS@/gpu4-slurm-%j.log
#SBATCH --export=NIL

set -euo pipefail
export HOME=@HOME@
export USER=${SLURM_JOB_USER:?}
export LOGNAME=$USER
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export TMPDIR=@BUILD_GPU@/tmp
mkdir -p "$TMPDIR"
source @CONTROL@/setup_gpu.sh

echo "job $SLURM_JOB_ID on $(hostname) gpus=$(nvidia-smi -L | wc -l)"
module -t list 2>&1 | tee @RESULTS@/gpu-modules.txt
command -v cmake mpicxx mpirun nvcc | tee @RESULTS@/gpu-tools.txt
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv,noheader \
    | tee @RESULTS@/gpu-gpus.txt

MPIWRAP=@CONTROL@/gpurank_wrapper.sh
chmod +x "$MPIWRAP"

cmake -S @SOURCE@ -B @BUILD_GPU@ \
    -DDDLA_USE_CUDA=ON \
    -DDDLA_USE_CCL=ON \
    -DBUILD_TESTS=ON \
    -DCMAKE_CUDA_ARCHITECTURES=70 \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER=g++ \
    -DMPIEXEC_EXECUTABLE="$MPIWRAP" \
    -DMPIEXEC_PREFLAGS=--oversubscribe \
    2>&1 | tee @RESULTS@/gpu-configure.log
cmake --build @BUILD_GPU@ --parallel 16 2>&1 | tee @RESULTS@/gpu-build.log

# Suite registered at 4 ranks (default DDLA_TEST_NP=4). test_ptran (6
# ranks) would fail the mpirun slot check here even with oversubscribe, so
# it is excluded and covered by the 6-GPU job.
export CUDA_VISIBLE_DEVICES=0,1,2,3
set +e
ctest --test-dir @BUILD_GPU@ --output-on-failure -j1 \
    -E "^test_ptran_mpi$" \
    --output-junit @RESULTS@/gpu4-ctest.xml 2>&1 | tee @RESULTS@/gpu4-ctest.log
rc=${PIPESTATUS[0]}
set -e

python3 @CONTROL@/report.py --kind gpu4 --junit @RESULTS@/gpu4-ctest.xml \
    --results @RESULTS@ --job-id "$SLURM_JOB_ID"
exit "$rc"
