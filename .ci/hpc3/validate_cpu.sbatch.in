#!/usr/bin/env bash
# CPU validation: configure, build and run the CPU-labelled tests.
#SBATCH --job-name=libddla-hpc3-cpu
#SBATCH --partition=@CPU_PARTITION@
#SBATCH --nodes=1
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=@CPU_CPUS@
#SBATCH --mem=@CPU_MEM@
#SBATCH --time=@CPU_TIME@
#SBATCH --output=@RESULTS@/cpu-slurm-%j.log
#SBATCH --export=NIL

set -euo pipefail
export HOME=@HOME@
export USER=${SLURM_JOB_USER:?}
export LOGNAME=$USER
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# @BUILD_CPU@ is on the node-local /tmp (see submit.sh); remove it on exit.
trap 'rm -rf "@BUILD_CPU@"' EXIT
trap 'exit 143' TERM
export TMPDIR=@BUILD_CPU@/tmp
mkdir -p "$TMPDIR"
source @CONTROL@/setup_cpu.sh
export CUDA_VISIBLE_DEVICES=
export OMPI_MCA_plm=isolated
# One OpenMP (and OpenMP-built OpenBLAS) thread per CPU of the rank: unset,
# each of the 4 ranks starts 8 threads on the 8 allocated CPUs and the suite
# runs 8x slower (303 s vs 37 s, measured 2026-10-24).
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=$OMP_NUM_THREADS
export OMP_DYNAMIC=false OMP_WAIT_POLICY=PASSIVE GOMP_SPINCOUNT=0
export OMPI_MCA_rmaps_base_mapping_policy=slot:PE=$SLURM_CPUS_PER_TASK
export OMPI_MCA_hwloc_base_binding_policy=core
if [[ @PROFILE@ == quick ]]; then
    export DDLA_TEST_GRID_MODE=balanced
fi

echo "job $SLURM_JOB_ID on $(hostname)"
module -t list 2>&1 | tee @RESULTS@/cpu-modules.txt
command -v cmake mpicxx mpirun | tee @RESULTS@/cpu-tools.txt

cmake -S @SOURCE@ -B @BUILD_CPU@ \
    -DBUILD_TESTS=ON \
    -DDDLA_BUILD_BENCHMARKS=OFF \
    -DDDLA_CPU_BLAS_LIBRARY=$OPENBLAS \
    -DCMAKE_BUILD_TYPE=Release \
    2>&1 | tee @RESULTS@/cpu-configure.log
build_start=$SECONDS
cmake --build @BUILD_CPU@ --parallel "$SLURM_CPUS_ON_NODE" 2>&1 | tee @RESULTS@/cpu-build.log
echo "Build seconds: $((SECONDS - build_start))"

set +e
ctest --test-dir @BUILD_CPU@ -L cpu --output-on-failure --parallel "$SLURM_NTASKS" \
    --output-junit @RESULTS@/cpu-ctest.xml 2>&1 | tee @RESULTS@/cpu-ctest.log
rc=${PIPESTATUS[0]}
set -e

python3 @CONTROL@/report.py --kind cpu --junit @RESULTS@/cpu-ctest.xml \
    --results @RESULTS@ --job-id "$SLURM_JOB_ID"
exit "$rc"
