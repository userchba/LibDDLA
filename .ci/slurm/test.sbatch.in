#!/usr/bin/env bash
#SBATCH --job-name=libddla-gpu-tests
#SBATCH --dependency=afterok:@BUILD_JOB@
#SBATCH --export=NIL

set -euo pipefail
export HOME=@HOME@
export USER=${SLURM_JOB_USER:?}
export LOGNAME=$USER
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export OMP_NUM_THREADS=1
export TMPDIR=@BUILD@/tmp/${SLURM_JOB_ID}-${SLURM_ARRAY_TASK_ID:-0}
mkdir -p "$TMPDIR"
case_name=$(sed -n "${SLURM_ARRAY_TASK_ID:-1}p" @CASE_FILE@)
if [[ -z "$case_name" ]]; then
    echo "no test case for array index ${SLURM_ARRAY_TASK_ID:-1}" >&2
    exit 2
fi
case_key=$(printf '%s' "$case_name" | sed 's/[^A-Za-z0-9_.-]/_/g')
mkdir -p @RESULTS@/junit @RESULTS@/cases
cd @RESULTS@
source @MAPPING_ROOT@/${SLURM_JOB_PARTITION}.bash
source @CONTROL@/modules.sh
CI_SYSTEM_MPIRUN=$(readlink -f "$(command -v mpirun)")
CI_MPI_ROOT=$(dirname "$(dirname "$CI_SYSTEM_MPIRUN")")
export CI_SYSTEM_MPIRUN
export CI_CONTAINER_IMAGE=@CONTAINER_IMAGE@
export CI_MPI_ROOT
export CI_SOURCE=@SOURCE@
export CI_BUILD=@BUILD@
export CI_RESULTS=@RESULTS@
export CI_CONTROL=@CONTROL@
export CI_MAPPING_ROOT=@MAPPING_ROOT@
export MAP_OPT
export SLURM_EXPORT_ENV=ALL
export OMPI_MCA_plm_slurm_args=--external-launcher
export PRTE_MCA_plm_slurm_args=--external-launcher
container=(apptainer exec --nv --containall --cleanenv --bind /opt:/opt:ro --bind /usr:/usr:ro --bind /lib:/lib:ro --bind /lib64:/lib64:ro --bind "$CI_MPI_ROOT:$CI_MPI_ROOT:ro" --bind @SOURCE@:@SOURCE@:ro --bind @BUILD@:@BUILD@ --bind @RESULTS@:@RESULTS@ --bind @CONTROL@:@CONTROL@:ro --bind @MAPPING_ROOT@:@MAPPING_ROOT@:ro --env "PATH=$PATH" --env "TMPDIR=$TMPDIR" --env "LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}" --env "CPATH=${CPATH:-}" --env "LIBRARY_PATH=${LIBRARY_PATH:-}" --env "CMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH:-}" --env "CI_SYSTEM_MPIRUN=$CI_SYSTEM_MPIRUN" --env "MAP_OPT=$MAP_OPT" --env "SLURM_EXPORT_ENV=$SLURM_EXPORT_ENV" --env "OMPI_MCA_plm_slurm_args=$OMPI_MCA_plm_slurm_args" --env "PRTE_MCA_plm_slurm_args=$PRTE_MCA_plm_slurm_args")
if [[ -n ${CUDA_MPS_PIPE_DIRECTORY:-} ]]; then
    container+=(--bind "$CUDA_MPS_PIPE_DIRECTORY:/run/nvidia-mps" --env CUDA_MPS_PIPE_DIRECTORY=/run/nvidia-mps)
fi
if [[ -n ${CUDA_MPS_LOG_DIRECTORY:-} ]]; then
    container+=(--bind "$CUDA_MPS_LOG_DIRECTORY:/run/nvidia-mps-log" --env CUDA_MPS_LOG_DIRECTORY=/run/nvidia-mps-log)
fi
container+=("$CI_CONTAINER_IMAGE")
if [[ @DISABLE_NCCL_IB@ == true ]]; then
    export NCCL_IB_DISABLE=1
else
    unset NCCL_IB_DISABLE
fi
module -t list 2>&1 | tee "@RESULTS@/cases/${case_key}-modules.txt"
"${container[@]}" bash -lc 'command -v ctest mpirun nvidia-smi' | tee "@RESULTS@/cases/${case_key}-tools.txt"
"${container[@]}" nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv,noheader \
    | tee "@RESULTS@/cases/${case_key}-gpus.txt"
nvidia-smi dmon -s pucvmte -o T > "@RESULTS@/cases/${case_key}-dmon.log" &

set +e
python3 @CONTROL@/run_case.py \
    --manifest @RESULTS@/manifest.json --case "$case_name" \
    --ranks "$SLURM_NTASKS" \
    --junit "@RESULTS@/junit/${case_key}.xml" 2>&1 | tee "@RESULTS@/cases/${case_key}.log"
case_rc=${PIPESTATUS[0]}
set -e
exit "$case_rc"
