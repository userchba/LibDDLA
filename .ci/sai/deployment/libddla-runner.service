[Unit]
Description=LibDDLA SAI GitHub Actions relay
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=libddla-runner
Group=libddla-runner
WorkingDirectory=/home/libddla-runner/ci/runner
ExecStartPre=/usr/bin/python3 /home/libddla-runner/ci/deployment/preflight.py
ExecStart=/usr/bin/python3 /home/libddla-runner/ci/deployment/sandbox.py /home/libddla-runner/ci /home/libddla-runner/ci/runner/run.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=TMPDIR=/home/libddla-runner/ci/tmp
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DOTNET_EnableDiagnostics=0
Environment=DOTNET_CLI_HOME=/home/libddla-runner/ci/work/home
Environment=XDG_CACHE_HOME=/home/libddla-runner/ci/cache
UnsetEnvironment=SSH_AUTH_SOCK SSH_AGENT_PID DBUS_SESSION_BUS_ADDRESS LD_PRELOAD PYTHONPATH
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=~@mount @module @reboot @swap @raw-io @obsolete ptrace process_vm_readv process_vm_writev pidfd_getfd keyctl add_key request_key bpf
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=0
CPUQuota=200%
CPUWeight=50
IOWeight=50
OOMPolicy=kill
Restart=always
RestartSec=60
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
